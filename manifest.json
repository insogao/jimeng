{
    "manifest_version": 3,
    "name": "Jimeng / Dreamina Connector",
    "version": "1.1",
    "description": "Generate images using Jimeng/Dreamina AI authentication from your browser session.",
    "permissions": [
        "activeTab",
        "cookies",
        "storage",
        "downloads",
        "nativeMessaging"
    ],
    "host_permissions": [
        "*://*.jianying.com/*",
        "*://*.capcut.com/*",
        "*://*.bytedanceapi.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Jimeng AI"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "web_accessible_resources": [
        {
            "resources": ["api/*"],
            "matches": ["<all_urls>"]
        }
    ]
}